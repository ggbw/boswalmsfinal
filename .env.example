# Copy the secret half of this file to .env.local (gitignored) and fill it in.
# The public half already lives in the tracked .env — it ships in the browser
# bundle, so it is not secret.

# --- tracked in .env, safe to publish ---------------------------------------
# SUPABASE_URL / VITE_SUPABASE_URL   https://<project-ref>.supabase.co
# VITE_SUPABASE_PROJECT_ID           <project-ref>
# SUPABASE_PUBLISHABLE_KEY / VITE_SUPABASE_PUBLISHABLE_KEY   anon JWT

# --- .env.local only, NEVER commit ------------------------------------------

# Bypasses every RLS policy. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# Controls the whole Supabase account, not just this project.
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""
