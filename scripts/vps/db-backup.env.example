# /opt/db-backup-boswa/.env — template. Copy, fill in, chmod 600.
#
# Never commit the filled-in version. The Postgres URI in here is full
# read/write access to every record in the school; the GPG passphrase is the
# only thing standing between a stolen Google account and the same data.
#
# Setup instructions: docs/BACKUP_AND_RESTORE.md §6.

# ── Where the data comes from ────────────────────────────────────────────────
# Supabase Dashboard → Connect → "Session pooler". Use the pooler string, not
# the direct db.<ref>.supabase.co one: direct connections are IPv6-only and the
# Contabo VPS is IPv4. Substitute the database password (Settings → Database →
# Reset database password if nobody has it).
# The host below is this project's real one (region eu-west-1). Copy the string
# from the dashboard anyway rather than trusting this line — the aws-N prefix
# and the region both vary, and a stale example is how people end up debugging
# a password that was never wrong.
PGURI="postgresql://postgres.gmdbrgjxdeztgzvqsaaj:YOUR_DB_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Which schemas to dump. 'public' is the school's data and structure. Adding
# 'auth' also captures the login accounts, if the database role is allowed to
# read that schema — try it, and drop back to 'public' if pg_dump refuses.
DUMP_SCHEMAS="public"

# ── Where the report goes ────────────────────────────────────────────────────
SUPABASE_URL="https://gmdbrgjxdeztgzvqsaaj.supabase.co"

# Must match the BACKUP_REPORT_SECRET set on the backup-report edge function
# (Supabase → Edge Functions → Secrets). Generate with:
#   openssl rand -hex 32
BACKUP_REPORT_SECRET=""

# ── Where the backups go ─────────────────────────────────────────────────────
# An rclone remote configured against the school's Google account, plus the
# folder inside that Drive. Created by `rclone config` — see §6.3.
RCLONE_REMOTE="gdrive:BoswaLMS-Backups"

# Daily copies older than this are deleted from Drive. The 1st of each month is
# also filed under monthly/, which is never pruned.
KEEP_DAYS="30"

# ── Encryption (recommended) ─────────────────────────────────────────────────
# Leave empty to upload the dump unencrypted. Set it and every dump is
# AES-256 symmetric GPG. Store the passphrase in the password manager as well
# as here — a backup nobody can decrypt is not a backup.
GPG_PASSPHRASE=""

# ── Supabase Storage mirror ──────────────────────────────────────────────────
# A copy of each night's dump is put in the private db-backups bucket so the
# Backup page can offer it. Supabase caps uploads at 50 MB by default; dumps
# larger than this are skipped (Drive is unaffected) and the run says so.
MIRROR_MAX_MB="45"

# ── Restore testing ──────────────────────────────────────────────────────────
# A superuser connection to the VPS's OWN Postgres. db-restore-test.mjs creates
# and drops databases here, so it must never point at Supabase — the script
# refuses to start if it does.
LOCAL_PGURI="postgresql://postgres:LOCAL_PASSWORD@localhost:5432/postgres"

# Prefix for file names and the scratch database. One word, no spaces. A second
# customer on this VPS gets a second folder with a different label.
BACKUP_LABEL="boswa"
